{
    "name": "pieceofcake2/aws",
    "description": "AWS SDK integration for CakePHP 2: S3 stream wrapper, DynamoDB session handler and cache engine, and Amazon SES email transport",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "aws", "s3", "dynamodb", "cache", "ses"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "aws/aws-sdk-php": "^3.343",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Aws"
    }
}
