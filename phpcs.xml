    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="parallel" value="16"/>

    <file>./Config</file>
    <file>./Controller</file>
    <file>./Lib</file>
    <file>./Model</file>
    <file>./Network</file>
    <file>./tests</file>

    <rule ref="CakePHP2"/>
</ruleset>
